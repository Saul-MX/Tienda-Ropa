HOST=0.0.0.0
PORT=1337
# URL pública de Strapi en producción, p. ej. https://api.tudominio.com
PUBLIC_URL=
# true cuando corre detrás de un proxy (Railway, Render, Nginx)
IS_PROXIED=false

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Base de datos: sqlite en local, postgres en producción
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/sauldt
# DATABASE_SSL=true

# Dominios que pueden hacer peticiones desde el navegador (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Imágenes en Cloudinary (si se omite, se guardan en public/uploads; solo para desarrollo)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=sauldt

# Tipo de cambio para reportar ventas en USD dentro del dashboard (todo se muestra en MXN)
USD_TO_MXN_RATE=18

# Carga productos de ejemplo la primera vez (solo si no hay productos)
SEED_DEMO_DATA=false
