{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Pedido"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "email": {
      "type": "email"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "cancelled",
        "refunded"
      ],
      "required": true,
      "default": "pending"
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "mxn",
        "usd"
      ],
      "required": true,
      "default": "mxn"
    },
    "locale": {
      "type": "enumeration",
      "enum": [
        "es",
        "en"
      ],
      "default": "es"
    },
    "subtotal": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "shippingCost": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "default": 0
    },
    "total": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.item"
    },
    "shippingAddress": {
      "type": "component",
      "repeatable": false,
      "component": "order.address"
    },
    "stripeSessionId": {
      "type": "string",
      "unique": true
    },
    "stripePaymentIntentId": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "stockApplied": {
      "type": "boolean",
      "default": false
    },
    "paidAt": {
      "type": "datetime"
    },
    "shippedAt": {
      "type": "datetime"
    },
    "deliveredAt": {
      "type": "datetime"
    }
  }
}
