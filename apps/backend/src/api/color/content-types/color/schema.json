{
  "kind": "collectionType",
  "collectionName": "colors",
  "info": {
    "singularName": "color",
    "pluralName": "colors",
    "displayName": "Color"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 40
    },
    "nameEn": {
      "type": "string",
      "maxLength": 40
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "hex": {
      "type": "string",
      "required": true,
      "regex": "^#([0-9a-fA-F]{6})$",
      "default": "#000000"
    }
  }
}
