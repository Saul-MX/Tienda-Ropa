{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Reseña",
    "description": "Solo se muestran en la tienda las reseñas aprobadas."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "reviews"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "body": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "authorName": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
