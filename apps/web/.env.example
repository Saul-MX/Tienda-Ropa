# Copia este archivo a .env.local y llena los valores.
# Las variables NEXT_PUBLIC_* son públicas (llegan al navegador). Todas las demás son secretas.

# --- Público ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_PANEL_URL=http://localhost:1337/admin

# --- Strapi (solo servidor) ---
STRAPI_URL=http://localhost:1337
# Se generan con: npm run tokens  (desde la raíz del repo)
STRAPI_READ_TOKEN=
STRAPI_ADMIN_TOKEN=

# Secreto compartido con el webhook de Strapi. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_...
# Local: lo imprime `stripe listen`. Producción: Developers > Webhooks > tu endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend (en pruebas puedes usar onboarding@resend.dev)
EMAIL_FROM=SauldT <pedidos@tudominio.com>
# Recibe un aviso por cada pedido pagado (opcional)
ADMIN_NOTIFICATION_EMAIL=
